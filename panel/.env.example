# Panel ayarları. Bu dosyayı .env olarak kopyalayıp doldurun.
ACI_DB_DSN=mysql:host=127.0.0.1;dbname=aci_tahta;charset=utf8mb4
ACI_DB_USER=aci_tahta
ACI_DB_PASS=
ACI_BASE_URL=https://tahta.bilgecelabs.com
# Yerel HTTP testinde 0, gerçek kurulumda 1
ACI_COOKIE_SECURE=1
# MeshCentral (uzaktan erişim). Anahtar, MeshCentral config.json'daki
# settings.loginCookieEncryptionKey ile aynı olmalı (openssl rand -hex 80).
ACI_MESH_URL=https://uzak.bilgecelabs.com
ACI_MESH_LOGIN_KEY=
ACI_MESH_GROUP=mesh//...
# Panelin MeshCentral'a komut göndermesi (uzaktan açma, web adresi açma, bildirim).
# Sadece tahta grubunda yetkili ayrı bir MeshCentral kullanıcısı.
ACI_MESH_WSS=wss://127.0.0.1:4430
ACI_MESH_API_USER=panel-api
ACI_MESH_API_PASS=
